# Server-only administrator authentication & session configuration (Vercel Environment Variables)
# Never commit real values. Use a unique, strong password and a random 32+ character secret.
ADMIN_SESSION_SECRET=replace_with_a_random_secret_at_least_32_characters

# Optional fallback administrator credentials (if not using Supabase Auth + admin_access)
ADMIN_USERNAME=replace_with_your_admin_username
ADMIN_PASSWORD=replace_with_a_unique_strong_password

# Supabase project configuration (SUPABASE_SERVICE_ROLE_KEY is strictly server-only)
SUPABASE_URL=https://pwoyfialzlwxamhawfyy.supabase.co
SUPABASE_ANON_KEY=replace_with_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
